---
layout: page
---
{{ content }}

{% if page.collection and page.collection.size > 0 %}
  {% assign collection = site[page.collection] %}
  {% if collection and collection.size > 0 %}
    {% comment %} First, group books by started year {% endcomment %}
    {% assign years = "" | split: "" %}
    {% for item in collection %}
      {% assign started_year = item.started | split: "-" | first %}
      {% unless years contains started_year %}
        {% assign years = years | push: started_year %}
      {% endunless %}
    {% endfor %}
    
    {% comment %} Sort years in descending order (most recent first) {% endcomment %}
    {% assign years = years | sort | reverse %}
    
    {% comment %} Iterate through each year {% endcomment %}
    {% for year in years %}
      <h1 id="y{{year}}">
        <a href="{{ year | prepend: '/books/' | relative_url }}">{{ year }}</a>
      </h1>
      <ul>
      
      {% comment %} Get books for this year and sort them {% endcomment %}
      {% assign year_books = collection | where_exp: "item", "item.started contains year" %}
      {% assign sorted_year_books = year_books | sort: "title" %}
      {% assign sorted_year_books = sorted_year_books | sort: "stars" | reverse %}
      
      {% comment %} Display books for this year {% endcomment %}
      {% for item in sorted_year_books %}
        <figure class="cover">
          <a class="cover-link" href="{{ item.url | relative_url }}">
            {% if item.cover %}
              <img alt="{{ item.title }} cover" src="{{ item.cover | prepend: page.covers | relative_url }}" style="height:200px">
            {% elsif item.olid %}
              <img alt="{{ item.title }} cover" src="http://covers.openlibrary.org/b/olid/{{ item.olid }}-L.jpg?default=false" style="height:200px">
            {% elsif item.isbn %}
              <img alt="{{ item.title }} cover" src="http://covers.openlibrary.org/b/isbn/{{ item.isbn }}-L.jpg?default=false" style="height:200px">
            {% endif %}
            {% if item.status %}
              {% assign statuses = 'abandoned,finished,interested,paused,queued,reading,reread' | split: ',' %}
              {% assign status = item.status | downcase | strip %}
              {% if statuses contains status %}
                <figcaption class="{{ status | downcase }}">{{ status | upcase }}</figcaption>
              {% else %}
                <figcaption class="uncategorized">UNCATEGORIZED</figcaption>
              {% endif %}
            {% else %}
              <figcaption class="uncategorized">UNCATEGORIZED</figcaption>
            {% endif %}
          </a>
        </figure>
      {% endfor %}
      </ul>
    {% endfor %}
  {% endif %}
{% endif %}
